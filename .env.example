# Get the database URL from Neon (recommended free Postgres for Amplify).
# https://console.neon.tech → create project → Connection string
DATABASE_URL="postgresql://user:password@localhost:5432/pharm_lms?schema=public"

# Optional: lower pool size on Amplify / serverless-ish hosts (default 10).
# PG_POOL_MAX=5
# PG_IDLE_TIMEOUT_MS=20000
# PG_CONN_TIMEOUT_MS=15000

# JWT signing (required in production). NEXTAUTH_SECRET is accepted as an alias.
AUTH_SECRET="replace-with-strong-secret"
# NEXTAUTH_SECRET="same-value-if-your-host-only-provides-this-name"
AUTH_TRUST_HOST="true"

# Canonical site URL (include https, no trailing slash).
# On AWS Amplify: set both to your Amplify default domain or custom domain, e.g.
#   https://main.d1234abcd.amplifyapp.com
#   or https://your-domain.com
# Must match the origin users open (www vs apex).
# AUTH_URL="https://your-domain.com"
# Also used for Open Graph metadata (lib/site-metadata.ts).
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Optional Amplify alias (same value as AUTH_URL if you prefer this name):
# AWS_APP_URL="https://your-domain.com"
#
# Google OAuth (optional): create an OAuth 2.0 Client ID in Google Cloud Console
# (Web application). Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple Sign in (optional). Services ID as client ID; secret per Auth.js / Apple docs (often a JWT).
# Redirect URI: http://localhost:3000/api/auth/callback/apple (and production URL in Apple Developer).
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Sign-up verification emails use Resend (not NextAuth — Auth.js does not send these).
# Without RESEND_API_KEY, the OTP is only printed in the server logs.
RESEND_API_KEY=""
EMAIL_FROM="Pharm LMS <onboarding@resend.dev>"

SEED_ADMIN_EMAIL="admin@pharmlms.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Media storage (Cloudflare R2 or any S3-compatible API, including AWS S3).
# For AWS S3: R2_ENDPOINT=https://s3.<region>.amazonaws.com and add the bucket
# hostname to next.config.ts images.remotePatterns.
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="pharm-lms-files"

JITSI_DOMAIN="meet.jit.si"

# Paystack (course checkout & tutor withdrawals).
# Test keys: Paystack dashboard → Settings → API Keys & Webhooks.
# Production webhook: https://<your-domain>/api/paystack/webhook
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Multi-currency display (NGN catalog prices; USD for non-Nigeria visitors).
# Paystack always charges NGN (MVP).
# Geo: Vercel sets x-vercel-ip-country; CloudFront sets cloudfront-viewer-country;
# profile country overrides when set.
DEFAULT_DISPLAY_CURRENCY="USD"
# FX_CACHE_TTL_SECONDS=3600
# Optional ExchangeRate-API key (https://www.exchangerate-api.com/); omit to use open.er-api.com.
# EXCHANGERATE_API_KEY=""

HUGGINGFACE_API_KEY=""
HUGGINGFACE_QUIZ_MODEL="mistralai/Mistral-7B-Instruct-v0.3"

# Upstash Redis (shared rate limits across instances). Optional — falls back to in-memory.
# https://console.upstash.com → Redis → REST URL + token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (runtime uses DSN from wizard/.env). Sourcemap upload only when token is set.
# SENTRY_AUTH_TOKEN=""
# DISABLE_SENTRY_SOURCEMAP_UPLOAD=1
