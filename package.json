{
  "name": "pharm-lms",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "postinstall": "prisma generate",
    "build": "next build --webpack",
    "build:prod": "next build --webpack",
    "clean:next": "node -e \"try{require('node:fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "prestart": "pnpm run build:prod",
    "start": "next start",
    "start:prod": "pnpm run clean:next && pnpm run build:prod && next start",
    "lint": "biome check",
    "test": "tsx --test tests/**/*.test.ts",
    "format": "biome format --write",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync": "prisma format && prisma db push && prisma generate",
    "db:sync:force": "prisma format && prisma db push --accept-data-loss && prisma generate",
    "db:reset": "prisma migrate reset --force",
    "factory-reset": "pnpm run db:clear-storage:apply && pnpm run db:reset && pnpm run db:seed",
    "db:repair-course-authors": "tsx scripts/repair-course-author-roles.ts",
    "db:repair-course-authors:apply": "tsx scripts/repair-course-author-roles.ts --apply",
    "db:clear-storage": "tsx scripts/clear-r2-storage.ts",
    "db:clear-storage:apply": "tsx scripts/clear-r2-storage.ts --apply --clear-db",
    "db:r2-cors": "tsx scripts/configure-r2-cors.ts",
    "db:backfill-course-duration": "tsx scripts/backfill-course-estimated-duration.ts",
    "db:backfill-course-duration:apply": "tsx scripts/backfill-course-estimated-duration.ts --apply",
    "report:pdf": "tsx scripts/generate-project-report-pdf.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/inference": "^4.13.15",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remixicon/react": "^4.9.0",
    "@types/nodemailer": "^8.0.0",
    "ai": "^6.0.168",
    "apexcharts": "^5.10.6",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.8.0",
    "motion": "^12.40.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-apexcharts": "^2.1.0",
    "react-dom": "19.2.4",
    "react-paystack": "^6.0.0",
    "recharts": "3.8.0",
    "resend": "^6.12.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright": "^1.59.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
